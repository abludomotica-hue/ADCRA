{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ADCRARemotionCompositionSchema",
  "description": "Esquema formal para composiciones de video programático en React con Remotion y generación de variantes parametrizadas en ADCRA",
  "type": "object",
  "required": [
    "campaign_id",
    "composition_id",
    "format",
    "brand_meta",
    "audio_track",
    "scenes",
    "variants"
  ],
  "properties": {
    "campaign_id": { "type": "string" },
    "composition_id": { "type": "string" },
    "format": {
      "type": "object",
      "required": ["width", "height", "fps", "duration_in_frames", "duration_seconds"],
      "properties": {
        "width": { "type": "integer", "minimum": 360 },
        "height": { "type": "integer", "minimum": 640 },
        "fps": { "type": "number", "minimum": 12.0 },
        "duration_in_frames": { "type": "integer", "minimum": 1 },
        "duration_seconds": { "type": "number", "minimum": 0.1 }
      }
    },
    "brand_meta": {
      "type": "object",
      "required": ["name", "claim", "primary_color", "accent_color", "cta_url"],
      "properties": {
        "name": { "type": "string" },
        "claim": { "type": "string" },
        "primary_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "accent_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "cta_url": { "type": "string" },
        "logo_path": { "type": "string" }
      }
    },
    "audio_track": {
      "type": "object",
      "required": ["src", "bpm", "duration_seconds"],
      "properties": {
        "src": { "type": "string" },
        "bpm": { "type": "number" },
        "duration_seconds": { "type": "number" }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "start_frame",
          "duration_frames",
          "video_src",
          "text_overlay",
          "style"
        ],
        "properties": {
          "scene_id": { "type": "string" },
          "start_frame": { "type": "integer", "minimum": 0 },
          "duration_frames": { "type": "integer", "minimum": 1 },
          "video_src": { "type": "string" },
          "text_overlay": { "type": "string" },
          "style": { "type": "string" }
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["variant_id", "name", "target_audience", "props_override"],
        "properties": {
          "variant_id": { "type": "string" },
          "name": { "type": "string" },
          "target_audience": { "type": "string" },
          "props_override": { "type": "object" },
          "output_file": { "type": "string" }
        }
      }
    }
  }
}
