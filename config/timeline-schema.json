{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ADCRATimelineSchema",
  "description": "Esquema formal para representación de timelines multicapa sincronizados al beat para DaVinci Resolve, EDL y FFmpeg",
  "type": "object",
  "required": [
    "campaign_id",
    "timeline_id",
    "timeline_format",
    "audio_master",
    "tracks",
    "sync_metrics"
  ],
  "properties": {
    "campaign_id": { "type": "string" },
    "timeline_id": { "type": "string" },
    "timeline_format": {
      "type": "object",
      "required": ["width", "height", "fps", "duration_seconds", "duration_frames"],
      "properties": {
        "width": { "type": "integer", "minimum": 360 },
        "height": { "type": "integer", "minimum": 640 },
        "fps": { "type": "number", "minimum": 12.0 },
        "duration_seconds": { "type": "number", "minimum": 0.1 },
        "duration_frames": { "type": "integer", "minimum": 1 }
      }
    },
    "audio_master": {
      "type": "object",
      "required": ["file_path", "tempo_bpm", "commercial_cut_seconds"],
      "properties": {
        "file_path": { "type": "string" },
        "tempo_bpm": { "type": "number" },
        "commercial_cut_seconds": { "type": "number" }
      }
    },
    "tracks": {
      "type": "object",
      "required": ["video_tracks", "audio_tracks"],
      "properties": {
        "video_tracks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["track_index", "track_name", "clips"],
            "properties": {
              "track_index": { "type": "integer", "minimum": 1 },
              "track_name": { "type": "string" },
              "clips": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "clip_id",
                    "source_path",
                    "record_in_frame",
                    "record_out_frame",
                    "duration_frames",
                    "record_in_seconds",
                    "record_out_seconds"
                  ],
                  "properties": {
                    "clip_id": { "type": "string" },
                    "scene_id": { "type": "string" },
                    "source_path": { "type": "string" },
                    "source_in_frame": { "type": "integer", "minimum": 0 },
                    "source_out_frame": { "type": "integer", "minimum": 1 },
                    "record_in_frame": { "type": "integer", "minimum": 0 },
                    "record_out_frame": { "type": "integer", "minimum": 1 },
                    "duration_frames": { "type": "integer", "minimum": 1 },
                    "record_in_seconds": { "type": "number", "minimum": 0.0 },
                    "record_out_seconds": { "type": "number", "minimum": 0.0 },
                    "beat_sync": {
                      "type": "object",
                      "properties": {
                        "aligned_beat_seconds": { "type": "number" },
                        "drift_ms": { "type": "number" },
                        "is_downbeat": { "type": "boolean" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "audio_tracks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["track_index", "track_name", "clips"],
            "properties": {
              "track_index": { "type": "integer", "minimum": 1 },
              "track_name": { "type": "string" },
              "clips": { "type": "array", "minItems": 1 }
            }
          }
        }
      }
    },
    "sync_metrics": {
      "type": "object",
      "required": ["total_cuts", "max_beat_drift_ms", "average_beat_drift_ms", "beat_alignment_rate"],
      "properties": {
        "total_cuts": { "type": "integer", "minimum": 1 },
        "max_beat_drift_ms": { "type": "number" },
        "average_beat_drift_ms": { "type": "number" },
        "beat_alignment_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "downbeat_cuts_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
