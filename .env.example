# ==============================================================================
# ADCRA — ENVIRONMENT CONFIGURATION TEMPLATE
# Autonomous Digital Campaign & Creative Production System
# ==============================================================================
# Copy this file to .env and configure the variables according to your deployment.
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MISSION CONTROL SERVER CONFIGURATION
# ------------------------------------------------------------------------------
ADCRA_HOST=0.0.0.0
ADCRA_PORT=8080
ADCRA_ENV=production        # Options: development, staging, production
ADCRA_LOG_LEVEL=INFO        # Options: DEBUG, INFO, WARNING, ERROR

# ------------------------------------------------------------------------------
# 2. AI BRAIN & LLM PROVIDER API KEYS
# At least one provider key is recommended for full generative capabilities.
# Local providers (Ollama / vLLM) can be used without external API keys.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Local / Self-Hosted LLM Configuration (Optional)
OLLAMA_HOST=http://localhost:11434
VLLM_HOST=http://localhost:8000

# ------------------------------------------------------------------------------
# 3. MODEL ROUTING & VERBAL ECONOMY
# ------------------------------------------------------------------------------
# Strategy: quality, cost, speed, balanced, local_only
ADCRA_ROUTING_STRATEGY=balanced

# Strict token management to avoid hallucination and token waste
ADCRA_VERBAL_ECONOMY=true
ADCRA_MAX_OUTPUT_TOKENS=2048
ADCRA_DEFAULT_TEMPERATURE=0.7

# ------------------------------------------------------------------------------
# 4. AUDIOVISUAL RENDERING & PRODUCTION ENGINES
# ------------------------------------------------------------------------------
# Rendering Mode:
# - hybrid: Uses DaVinci Resolve Studio if available; falls back to Remotion/FFmpeg
# - resolve_only: Requires DaVinci Resolve Studio running with scripting API enabled
# - headless: Remotion / HyperFrames / FFmpeg only (ideal for Docker & Cloud VMs)
DEFAULT_RENDER_ENGINE=hybrid

# DaVinci Resolve Studio Configuration (Optional - only needed for Mode A)
# Linux default: /opt/resolve/libs/Fusion
# macOS default: /Applications/DaVinci Resolve/DaVinci Resolve.app/Contents/Libraries/Fusion
# Windows default: C:\Program Files\Blackmagic Design\DaVinci Resolve
RESOLVE_SCRIPT_API=/opt/resolve/libs/Fusion
RESOLVE_SCRIPT_LIB=/opt/resolve/libs/Fusion/fusionscript.so
RESOLVE_HEADLESS=false

# Remotion & Node.js Rendering (Mode B)
REMOTION_CONCURRENCY=4
REMOTION_GL_BACKEND=angle    # Options: angle, egl, swiftshader (CPU)

# ------------------------------------------------------------------------------
# 5. HARDWARE ACCELERATION & PROBE
# ------------------------------------------------------------------------------
ENABLE_HARDWARE_PROBE=true
FORCE_GPU_DEVICE=0           # Set to GPU ID if multiple GPUs installed

# ------------------------------------------------------------------------------
# 6. STORAGE & CAMPAIGN DATA PATHS
# ------------------------------------------------------------------------------
CAMPAIGN_STORAGE_PATH=./campaign
MEMORY_STORAGE_PATH=./campaign/memory
DELIVERABLES_PATH=./campaign/deliverables
